<div class="flex min-h-dvh flex-col">
  <header class="h-20 border-b border-base-300 bg-base-100 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto flex h-full max-w-5xl items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="text-xl font-semibold tracking-tight text-base-content">
          elixirmachine
        </a>
        <span class="hidden h-6 w-px bg-base-300 sm:inline"></span>
        <span class="hidden text-base font-medium text-base-content/70 sm:inline">
          Configurator
        </span>
      </div>
      <.theme_toggle />
    </div>
  </header>

  <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
    <div class="toast toast-top toast-end z-50">
      <.flash_group flash={@flash} />
    </div>
    <div class="mx-auto max-w-3xl">
      {@inner_content}
    </div>
  </main>
</div>
